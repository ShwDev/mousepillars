{
	"schemaVersion": 1,
	"id": "mousepillars",
	"version": "${version}",
	"name": "mousePillars",
	"description": "Pilares que transforman al jugador en ratón dentro de un área, inspirados en el Palacio de Shido de Persona 5.",
	"authors": [
		"shaw"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mousepillars/icon.png",
	"environment": "*",
	"entrypoints": {
